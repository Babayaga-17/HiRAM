@{
    var displayName = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(displayName)) displayName = "HiRAM User";
    var initial = displayName.Substring(0, 1).ToUpperInvariant();
    var topbarPage = ViewData["TopbarPage"]?.ToString() ?? "Equipment categories";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | HiRAM</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
    <svg class="icon-library" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
        <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="i-box" viewBox="0 0 24 24"><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="M3 7v10l9 5 9-5V7M12 12v10"/></symbol>
        <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5"/></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4M17 3v4M3 10h18"/></symbol>
        <symbol id="i-tools" viewBox="0 0 24 24"><path d="M14 7a5 5 0 0 0-6.5 6.5L3 18l3 3 4.5-4.5A5 5 0 0 0 17 10l-3 3-3-3 3-3Z"/></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V12M10 20V4M16 20v-8M22 20H2"/></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.8 1.8 0 0 0 .36 2l-1.8 1.8a1.8 1.8 0 0 0-2-.36l-.7.29V21h-2.5v-2.27l-.7-.29a1.8 1.8 0 0 0-2 .36l-1.8-1.8a1.8 1.8 0 0 0 .36-2l-.29-.7H6v-2.5h2.27l.29-.7a1.8 1.8 0 0 0-.36-2l1.8-1.8a1.8 1.8 0 0 0 2 .36l.7-.29V5h2.5v2.27l.7.29a1.8 1.8 0 0 0 2-.36l1.8 1.8a1.8 1.8 0 0 0-.36 2l.29.7H22v2.5h-2.27l-.33.8Z" transform="translate(-1.5 -1.5)"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></symbol>
        <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="m14 5 5 5M4 20l4.5-1 11-11a2 2 0 0 0-3-3l-11 11L4 20Z"/></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></symbol>
        <symbol id="i-dots" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></symbol>
        <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5 5 19"/></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5M15 7l5 5-5 5M9 12h11"/></symbol>
    </svg>

    <div class="app-shell">
        <div class="sidebar-scrim" id="sidebarScrim"></div>
        <aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
            <a class="app-brand" asp-controller="Category" asp-action="Index" aria-label="HiRAM home">
                <span class="app-brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M7 5.5v21M25 5.5v21M7 16h18"/><circle cx="7" cy="5.5" r="2.5"/><circle cx="25" cy="26.5" r="2.5"/></svg></span>
                <span class="app-brand-copy"><strong>HiRAM</strong><small>RESOURCE MANAGEMENT</small></span>
            </a>

            <nav class="sidebar-nav">
                <span class="nav-caption">WORKSPACE</span>
                <span class="nav-link nav-link-disabled" aria-disabled="true"><svg class="icon"><use href="#i-grid"/></svg>Dashboard<span class="nav-soon">Soon</span></span>
                <span class="nav-caption nav-caption-spaced">MANAGE</span>
                <span class="nav-link nav-link-disabled" aria-disabled="true"><svg class="icon"><use href="#i-box"/></svg>Equipment<span class="nav-soon">Soon</span></span>
                <a class="nav-link nav-link-active" asp-controller="Category" asp-action="Index" aria-current="page"><svg class="icon"><use href="#i-layers"/></svg>Categories<span class="active-dot"></span></a>
                <span class="nav-link nav-link-disabled" aria-disabled="true"><svg class="icon"><use href="#i-calendar"/></svg>Reservations<span class="nav-soon">Soon</span></span>
                <span class="nav-link nav-link-disabled" aria-disabled="true"><svg class="icon"><use href="#i-tools"/></svg>Maintenance<span class="nav-soon">Soon</span></span>
                <span class="nav-caption nav-caption-spaced">INSIGHTS</span>
                <span class="nav-link nav-link-disabled" aria-disabled="true"><svg class="icon"><use href="#i-chart"/></svg>Reports<span class="nav-soon">Soon</span></span>
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-help"><span class="sidebar-help-icon"><svg class="icon"><use href="#i-info"/></svg></span><strong>Built for better borrowing</strong><p>Keep every resource organized and ready to use.</p></div>
                <span class="sidebar-version">HiRAM &middot; School Resource Management</span>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="topbar-start">
                    <button class="menu-toggle icon-button" id="menuToggle" type="button" aria-label="Open navigation" aria-controls="appSidebar" aria-expanded="false"><svg class="icon"><use href="#i-menu"/></svg></button>
                    <div class="topbar-location"><span>Workspace</span><svg class="icon"><use href="#i-chevron"/></svg><strong>@topbarPage</strong></div>
                </div>
                <div class="topbar-end">
                    <span class="topbar-divider"></span>
                    <details class="profile-menu">
                        <summary><span class="avatar">@initial</span><span class="profile-copy"><strong>@displayName</strong><small>Signed in</small></span><svg class="icon profile-chevron"><use href="#i-chevron"/></svg></summary>
                        <div class="profile-dropdown"><div class="profile-dropdown-heading">@displayName</div><a asp-controller="Account" asp-action="SignOutUser"><svg class="icon"><use href="#i-logout"/></svg>Sign out</a></div>
                    </details>
                </div>
            </header>

            <main class="app-content" id="mainContent">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
