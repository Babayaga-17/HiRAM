@* Shared navigation shows the features available to the signed-in role. *@
@{
    var isBorrower = User.IsInRole("Borrower");
    var isAdmin = User.IsInRole("Admin");
    var canManage = User.IsInRole("Custodian") || isAdmin;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var isDashboardPage = currentController == "Dashboard";
    var isCategoriesPage = currentController == "EquipmentCategory";
    var isEquipmentPage = currentController == "Equipment";
    var isBorrowersPage = currentController == "BorrowerProfile";
    var isReservationsPage = currentController == "Reservation";

    // WBS 5.1 User and Role Management: same access rules the server enforces (Authorization/MenuAccess.cs).
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var canManageUsers = ASI.Basecode.WebApp.Authorization.MenuAccess.CanAccess(User, "UserAccount");
    var isUsersPage = currentController == "UserAccount" && currentAction != "RoleAccess";
    var isRoleAccessPage = currentController == "UserAccount" && currentAction == "RoleAccess";
    var isMyReservationsPage = currentController == "EquipmentReservation" && (currentAction == "Index" || currentAction == "Details");
    var isBrowsePage = currentController == "BrowseEquipment" || (currentController == "EquipmentReservation" && !isMyReservationsPage);
    var isBorrowerProfilesPage = currentController == "BorrowerProfile";
}

<aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
    <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="HiRAM home">
        <span class="app-brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M7 5.5v21M25 5.5v21M7 16h18"/><circle cx="7" cy="5.5" r="2.5"/><circle cx="25" cy="26.5" r="2.5"/></svg></span>
        <span class="app-brand-copy"><strong>HiRAM</strong><small>RESOURCE MANAGEMENT</small></span>
    </a>

    <nav class="sidebar-nav">
        <span class="nav-caption">WORKSPACE</span>

        <a class="@(isDashboardPage ? "nav-link nav-link-active" : "nav-link")"
           asp-controller="Dashboard"
           asp-action="Index"
           aria-current="@(isDashboardPage ? "page" : null)">
            <svg class="icon"><use href="#i-grid" /></svg>
            Dashboard
        </a>

        @if (isBorrower)
        {
            <span class="nav-caption nav-caption-spaced">BORROWING</span>

            <a class="@(isBrowsePage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="BrowseEquipment"
               asp-action="Index"
               aria-current="@(isBrowsePage ? "page" : null)">
                <svg class="icon"><use href="#i-box" /></svg>
                Browse Equipment
            </a>

            <a class="@(isMyReservationsPage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="EquipmentReservation"
               asp-action="Index"
               aria-current="@(isMyReservationsPage ? "page" : null)">
                <svg class="icon"><use href="#i-calendar" /></svg>
                My Reservations
            </a>

            <span class="nav-link nav-link-disabled" aria-disabled="true">
                My Borrowing History <span class="nav-soon">Soon</span>
            </span>
        }

        @if (canManage)
        {
            <span class="nav-caption nav-caption-spaced">MANAGE</span>

            <a class="@(isEquipmentPage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="Equipment"
               asp-action="Index"
               aria-current="@(isEquipmentPage ? "page" : null)">
                <svg class="icon"><use href="#i-box" /></svg>
                Equipment
            </a>

            <a class="@(isCategoriesPage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="EquipmentCategory"
               asp-action="Index"
               aria-current="@(isCategoriesPage ? "page" : null)">
                <svg class="icon"><use href="#i-layers" /></svg>
                Categories
            </a>

            <a class="@(isBorrowersPage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="BorrowerProfile"
               asp-action="Index"
               aria-current="@(isBorrowersPage ? "page" : null)">
                <svg class="icon"><use href="#i-users" /></svg>
                Borrowers
            </a>

            <a class="@(isReservationsPage ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="Reservation"
               asp-action="Pending"
               aria-current="@(isReservationsPage ? "page" : null)">
                <svg class="icon"><use href="#i-calendar" /></svg>
                Reservations
            </a>


            <span class="nav-link nav-link-disabled" aria-disabled="true">
                Maintenance <span class="nav-soon">Soon</span>
            </span>

            <span class="nav-caption nav-caption-spaced">INSIGHTS</span>

            <span class="nav-link nav-link-disabled" aria-disabled="true">
                Reports <span class="nav-soon">Soon</span>
            </span>
        }

        @if (isAdmin)
        {
            <span class="nav-caption nav-caption-spaced">ADMINISTRATION</span>

            @if (canManageUsers)
            {
                <a class="@(isUsersPage ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="UserAccount"
                   asp-action="Index"
                   aria-current="@(isUsersPage ? "page" : null)">
                    <svg class="icon"><use href="#i-users" /></svg>
                    Users &amp; Roles
                </a>

                <a class="@(isBorrowerProfilesPage ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="BorrowerProfile"
                   asp-action="Index"
                   aria-current="@(isBorrowerProfilesPage ? "page" : null)">
                    <svg class="icon"><use href="#i-users" /></svg>
                    Borrowers
                </a>

                <a class="@(isRoleAccessPage ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="UserAccount"
                   asp-action="RoleAccess"
                   aria-current="@(isRoleAccessPage ? "page" : null)">
                    <svg class="icon"><use href="#i-shield" /></svg>
                    Role Access
                </a>
            }

            <span class="nav-link nav-link-disabled" aria-disabled="true">
                Audit Logs <span class="nav-soon">Soon</span>
            </span>
        }
    </nav>

    <div class="sidebar-bottom">
        <div class="sidebar-help"><span class="sidebar-help-icon"><svg class="icon"><use href="#i-info"/></svg></span><strong>Built for better borrowing</strong><p>Keep every resource organized and ready to use.</p></div>
        <span class="sidebar-version">HiRAM &middot; School Resource Management</span>
    </div>
</aside>
