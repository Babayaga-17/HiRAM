@* Shared navigation shows the features available to the signed-in role. *@
@{
    // Navigation visibility
    var isBorrower = User.IsInRole("Borrower");
    var isAdmin = User.IsInRole("Admin");
    var canManageResources = User.IsInRole("Custodian") || isAdmin;

    var canManageUsers = ASI.Basecode.WebApp.Authorization.MenuAccess.CanAccess(User, "UserAccount");

    // Current destination
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string action = null)
    {
        return currentController == controller
            && (action == null || currentAction == action);
    }

    // Exceptions: these destinations share a controller.
    var isRoleAccessActive = IsActive("UserAccount", "RoleAccess");
    var isUsersActive = IsActive("UserAccount") && !isRoleAccessActive;

    var isMyReservationsActive = IsActive("EquipmentReservation", "Index") || IsActive("EquipmentReservation", "Details");

    var isBrowseActive = IsActive("BrowseEquipment") || (IsActive("EquipmentReservation") && !isMyReservationsActive);
}

<aside class="app-sidebar" id="appSidebar" aria-label="Main navigation">
    <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="HiRAM home">
        <span class="app-brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M7 5.5v21M25 5.5v21M7 16h18"/><circle cx="7" cy="5.5" r="2.5"/><circle cx="25" cy="26.5" r="2.5"/></svg></span>
        <span class="app-brand-copy"><strong>HiRAM</strong><small>RESOURCE MANAGEMENT</small></span>
    </a>

    <nav class="sidebar-nav">
        <span class="nav-caption">OVERVIEW</span>

        <a class="@(IsActive("Dashboard") ? "nav-link nav-link-active" : "nav-link")"
           asp-controller="Dashboard"
           asp-action="Index"
           aria-current="@(IsActive("Dashboard") ? "page" : null)">
            <svg class="icon"><use href="#i-grid" /></svg>
            Dashboard
        </a>

        @if (isBorrower)
        {
            <span class="nav-caption nav-caption-spaced">BORROWING</span>

            <a class="@(isBrowseActive ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="BrowseEquipment"
               asp-action="Index"
               aria-current="@(isBrowseActive ? "page" : null)">
                <svg class="icon"><use href="#i-box" /></svg>
                Browse Equipment
            </a>

            <a class="@(isMyReservationsActive ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="EquipmentReservation"
               asp-action="Index"
               aria-current="@(isMyReservationsActive ? "page" : null)">
                <svg class="icon"><use href="#i-calendar" /></svg>
                My Reservations
            </a>

            <a class="@(IsActive("Calendar") ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="AvailabilityCalendar"
               asp-action="Index"
               aria-current="@(IsActive("Calendar") ? "page" : null)">
                <svg class="icon"><use href="#i-eye" /></svg>
                Availability Calendar
            </a>

            <span class="nav-link nav-link-disabled" aria-disabled="true">
                My Borrowing History <span class="nav-soon">Soon</span>
            </span>
        }

        @if (canManageResources)
        {
            <span class="nav-caption nav-caption-spaced">MANAGE</span>

            <a class="@(IsActive("Reservation") ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="Reservation"
               asp-action="Pending"
               aria-current="@(IsActive("Reservation") ? "page" : null)">
                <svg class="icon"><use href="#i-calendar" /></svg>
                Reservations
            </a>

            <a class="@(IsActive("Calendar") ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="AvailabilityCalendar"
               asp-action="Index"
               aria-current="@(IsActive("Calendar") ? "page" : null)">
                <svg class="icon"><use href="#i-eye" /></svg>
                Availability Calendar
            </a>

            <span class="nav-link nav-link-disabled" aria-disabled="true">
                Maintenance <span class="nav-soon">Soon</span>
            </span>

            <a class="@(IsActive("Equipment") ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="Equipment"
               asp-action="Index"
               aria-current="@(IsActive("Equipment") ? "page" : null)">
                <svg class="icon"><use href="#i-box" /></svg>
                Equipment
            </a>

            <a class="@(IsActive("EquipmentCategory") ? "nav-link nav-link-active" : "nav-link")"
               asp-controller="EquipmentCategory"
               asp-action="Index"
               aria-current="@(IsActive("EquipmentCategory") ? "page" : null)">
                <svg class="icon"><use href="#i-layers" /></svg>
                Categories
            </a>
        }

        @if (isAdmin)
        {
            <span class="nav-caption nav-caption-spaced">PEOPLE & ACCESS</span>

            @if (canManageUsers)
            {
                <a class="@(IsActive("BorrowerProfile") ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="BorrowerProfile"
                   asp-action="Index"
                   aria-current="@(IsActive("BorrowerProfile") ? "page" : null)">
                    <svg class="icon"><use href="#i-users" /></svg>
                    Borrowers
                </a>

                <a class="@(IsActive("UserAccount") ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="UserAccount"
                   asp-action="Index"
                   aria-current="@(IsActive("UserAccount") ? "page" : null)">
                    <svg class="icon"><use href="#i-users" /></svg>
                    User Accounts
                </a>

                <a class="@(IsActive("RoleAccess") ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="UserAccount"
                   asp-action="RoleAccess"
                   aria-current="@(IsActive("RoleAccess") ? "page" : null)">
                    <svg class="icon"><use href="#i-shield" /></svg>
                    Role Access
                </a>

                <span class="nav-caption nav-caption-spaced">INSIGHTS</span>

                <a class="@(IsActive("Report") ? "nav-link nav-link-active" : "nav-link")"
                   asp-controller="Report"
                   asp-action="Index"
                   aria-current="@(IsActive("Report") ? "page" : null)">
                    <svg class="icon"><use href="#i-chart" /></svg>
                    Reports
                </a>
            }
        }
    </nav>

    <div class="sidebar-bottom">
        <div class="sidebar-help"><span class="sidebar-help-icon"><svg class="icon"><use href="#i-info"/></svg></span><strong>Built for better borrowing</strong><p>Keep every resource organized and ready to use.</p></div>
        <span class="sidebar-version">HiRAM &middot; School Resource Management</span>
    </div>
</aside>
