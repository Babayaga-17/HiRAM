@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@{
    ViewData["IsAccountPage"] = true;
    ViewData["UseLegacyAssets"] = false;
    ViewData["Title"] = "Register | HiRAM";
}

@section Styles {
    <link rel="stylesheet" href="~/css/password-toggle.css" asp-append-version="true" />
}

<main class="auth-shell login-shell registration-shell">
    <section class="form-panel" aria-labelledby="registerHeading">
        <header class="form-head">
            <h1 id="registerHeading">Create an account</h1>
            <p>Get started with your HiRAM account details.</p>
        </header>
        <p class="registration-notice">New accounts currently require administrator assistance. Contact your school administrator to complete registration.</p>
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert" role="alert">@error</div>
        }
        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="field">
                <label for="Email">Email</label>
                <input asp-for="Email" id="Email" type="email" autocomplete="email" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="Name">Full name</label>
                <input asp-for="Name" id="Name" type="text" autocomplete="name" placeholder="Enter your full name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="Password">Password</label>
                <div class="input-wrap password-field">
                <input asp-for="Password" id="Password" type="password" autocomplete="new-password" placeholder="Enter a password" />
                    <button type="button" class="password-toggle js-password-toggle" data-target="Password" aria-controls="Password" data-password-label="password" aria-label="Show password">
                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true" hidden><use href="#i-eye" /></svg>
                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-eye-closed" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="ConfirmPassword">Confirm password</label>
                <div class="input-wrap password-field">
                <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Enter your password again" />
                    <button type="button" class="password-toggle js-password-toggle" data-target="ConfirmPassword" aria-controls="ConfirmPassword" data-password-label="confirm password" aria-label="Show confirm password">
                        <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true" hidden><use href="#i-eye" /></svg>
                        <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-eye-closed" /></svg>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <button class="sign-in-button" type="submit">Register</button>
        </form>
        <p class="auth-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a></p>
    </section>
    <section class="auth-intro" aria-labelledby="registerIntroHeading">
        <h2 id="registerIntroHeading">Borrow with HiRAM</h2>
        <p>Use HiRAM to explore equipment, plan your borrowing schedule, and follow your requests.</p>
        <ul class="lending-steps">
            <li><svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>Find equipment for your classes</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-calendar" /></svg>Plan ahead with availability</li>
            <li><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>Keep track of every request</li>
        </ul>
    </section>
</main>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
