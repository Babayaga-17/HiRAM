@using ASI.Basecode.Services.ServiceModels
@model UserViewModel
@{
    ViewData["IsAccountPage"] = true;
    ViewData["UseLegacyAssets"] = false;
    ViewData["Title"] = "Register | HiRAM";
}

<main class="auth-shell">
    <section class="form-panel">
        <header class="form-head"><h1>Create an account</h1></header>
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert" role="alert">@error</div>
        }

        <form method="post" action="/Account/Register">
            <div class="field">
                <label for="userId">User ID</label>
                <input type="text" id="userId"
                       asp-for="UserId" placeholder="Enter userid" />
                <span asp-validation-for="UserId" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="name">Name</label>
                <input type="text" id="name"
                       asp-for="Name" placeholder="Enter name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password"
                       asp-for="Password" placeholder="Enter password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label for="confirmpassword">Confirm password</label>
                <input type="password" id="confirmpassword"
                       asp-for="ConfirmPassword" placeholder="Confirm Password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>
            <div class="btn-row">
                <button class="btn-primary" type="submit">
                    Register
                </button>
                <a asp-controller="Account" asp-action="Login">
                    Back to sign in
                </a>
            </div>
        </form>
    </section>
</main>
