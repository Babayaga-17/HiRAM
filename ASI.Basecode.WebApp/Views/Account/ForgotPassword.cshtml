@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot password | HiRAM";
    ViewData["IsAccountPage"] = true;
    ViewData["UseLegacyAssets"] = false;

    var error = ViewBag.Error as string;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;650;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/hiram-auth.css" asp-append-version="true" />
}

<main class="auth-shell">
    <section class="brand-panel">
        <div class="brand-row">
            <div class="brand-mark">H</div>
            <span class="brand-name">HiRAM</span>
        </div>
        <div class="brand-copy">
            <p class="eyebrow">School resource management</p>
            <h1>Locked out? We'll get you back in.</h1>
            <p>Enter your email and we'll send a code to reset your password.</p>
        </div>
        <div class="glass-card">
            <div>
                <strong>Equipment access</strong>
                <span>Organized and convenient</span>
            </div>
            <span class="badge">Ready</span>
        </div>
        <div class="brand-foot">Equipment Borrowing &amp; Reservation System</div>
    </section>

    <section class="form-panel">
        <div class="form-box">
            <div class="form-head">
                <h2>Forgot password?</h2>
                <p>Enter the email linked to your HiRAM account and we'll send you a 6-digit code.</p>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert" role="alert">@error</div>
            }

            <form id="forgotPasswordForm" asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="field">
                    <label for="email">Email</label>
                    <div class="input-wrap">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <input id="email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required autofocus />
                    </div>
                </div>
                <div class="btn-row">
                    <a class="btn-secondary" asp-controller="Account" asp-action="CancelReset">Cancel</a>
                    <button id="sendCodeButton"
                            type="submit"
                            class="btn-primary">
                        <span class="send-code-spinner"
                              aria-hidden="true"
                              hidden></span>
                        <span id="sendCodeLabel">Send code</span>
                    </button>
                    <span id="sendCodeStatus" class="send-code-status" role="status"></span>
                </div>
            </form>
        </div>
        <div class="form-foot">Secure access for the HiRAM school community</div>
    </section>
</main>

@section Scripts {
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
}
