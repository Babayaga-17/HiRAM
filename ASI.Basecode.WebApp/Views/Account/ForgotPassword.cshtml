@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot password | HiRAM";
    ViewData["IsAccountPage"] = true;
    ViewData["UseLegacyAssets"] = false;

    var error = ViewBag.Error as string;
}

<main class="auth-shell">
    <section class="form-panel">
        <div class="form-head">
            <h1>Forgot password?</h1>
            <p>Enter the email linked to your HiRAM account and we'll send you a 6-digit code.</p>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert" role="alert">@error</div>
        }

        <form id="forgotPasswordForm" asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="field">
                <label for="email">Email</label>
                <div class="input-wrap">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    <input id="email" name="email" type="email" placeholder="Enter your email" autocomplete="email" required autofocus />
                </div>
            </div>
            <div class="btn-row">
                <a class="btn-secondary" asp-controller="Account" asp-action="CancelReset">Cancel</a>
                <button id="sendCodeButton"
                        type="submit"
                        class="btn-primary">
                    <span class="send-code-spinner"
                          aria-hidden="true"
                          hidden></span>
                    <span id="sendCodeLabel">Send code</span>
                </button>
                <span id="sendCodeStatus" class="send-code-status" role="status"></span>
            </div>
        </form>
    </section>
</main>

@section Scripts {
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
}
