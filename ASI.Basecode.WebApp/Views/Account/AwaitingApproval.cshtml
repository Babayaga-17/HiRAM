@{
    ViewData["IsAccountPage"] = true;
    ViewData["UseLegacyAssets"] = false;
    ViewData["Title"] = "Awaiting approval | HiRAM";
}
@section Styles {
    <link rel="stylesheet" href="~/css/registration.css" asp-append-version="true" />
}
<main class="auth-shell registration-pending">
    <section class="form-panel" aria-labelledby="pendingHeading">
        @if (TempData["RegistrationEmailWarning"] is string warning)
        {
            <p class="registration-notice" role="status">@warning</p>
        }
        <h1 id="pendingHeading">Awaiting admin approval</h1>
        <p>Your registration has been saved. An administrator must approve your account before you can sign in.</p>
        <div class="registration-review-note"><strong>What happens next?</strong><p>We’ll attempt to email you when your registration is approved. You don’t need to register again while your request is pending.</p></div>
        <p class="registration-help">If your details need correcting, contact your HiRAM administrator.</p>
        <a class="sign-in-button registration-pending-link" asp-controller="Account" asp-action="Login">Back to sign in</a>
    </section>
</main>
