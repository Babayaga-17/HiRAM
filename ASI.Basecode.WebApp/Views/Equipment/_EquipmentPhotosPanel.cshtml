@{
    var isEdit = ViewData["PhotoMode"]?.ToString() == "edit";
}
<aside class="photo-panel" aria-label="Equipment photos">
    <div class="photo-panel-head">
        <h2>Equipment photos</h2>
        <span class="photo-count-pill">@(isEdit ? "3 / 5" : "0 / 5")</span>
    </div>

    <p class="photo-panel-text">
        The first photo is shown on borrower cards.
        @(isEdit ? "Changes apply after you save." : "Borrowers can browse the rest in the details view.")
    </p>

    @if (!isEdit)
    {
        <div class="photo-dropzone">
            <span class="photo-dropzone-icon">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5" /><path d="m7 9 5-5 5 5" /><path d="M5 19h14" /></svg>
            </span>
            <strong>Import images</strong>
            <span>Drag and drop photos here, or</span>
            <button type="button" class="button button-primary" title="Photo upload is coming soon">Browse files</button>
            <small>JPG, PNG or WebP &middot; up to 5 MB each</small>
        </div>

        <div class="photo-slots" aria-hidden="true">
            @for (var slot = 0; slot < 4; slot++)
            {
                <span class="photo-slot">
                    <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="1.6" /><path d="m4 18 5-5 4 4 3-3 4 4" /></svg>
                </span>
            }
        </div>

        <p class="photo-panel-note">Photos are optional. Items without a photo show a placeholder to borrowers.</p>
    }
    else
    {
        <div class="photo-main">
            <span class="photo-main-badge">Main photo</span>
            <span class="photo-main-icon">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="1.6" /><path d="m4 18 5-5 4 4 3-3 4 4" /></svg>
            </span>
            <span class="photo-main-label">CURRENT MAIN PHOTO</span>
            <div class="photo-main-actions">
                <button type="button" class="photo-action" title="Photo upload is coming soon">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7" /><path d="M20 5v6h-6" /></svg>Replace
                </button>
                <button type="button" class="photo-action photo-action-danger" title="Photo upload is coming soon">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16" /><path d="M9 7V4h6v3" /><path d="m6 7 1 13h10l1-13" /><path d="M10 11v6M14 11v6" /></svg>Remove
                </button>
            </div>
        </div>

        <div class="photo-thumbs">
            @for (var thumb = 0; thumb < 3; thumb++)
            {
                <button type="button" class="photo-thumb @(thumb == 0 ? "is-active" : "")" aria-label="Photo @(thumb + 1)">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="9" cy="10" r="1.6" /><path d="m4 18 5-5 4 4 3-3 4 4" /></svg>
                </button>
            }
            <button type="button" class="photo-thumb photo-thumb-add" aria-label="Add photo" title="Photo upload is coming soon">
                <svg class="icon"><use href="#i-plus" /></svg>
            </button>
        </div>

        <div class="photo-tip">
            <strong>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" /></svg>
                Set selected photo as main
            </strong>
            <span>JPG, PNG or WebP &middot; up to 5 MB each &middot; drag thumbnails to reorder</span>
        </div>
    }
</aside>