@using ASI.Basecode.Services.ServiceModels
@model List<PendingReservationListItem>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Pending Requests";
    ViewData["TopbarPage"] = "Pending requests";
    var loadError = TempData["ReservationLoadError"] as string;
}

<div class="page-heading">
    <div>
        <div class="eyebrow-line"><span class="eyebrow-dot"></span>APPROVAL AND RELEASE</div>
        <h1>Pending requests</h1>
        <p>Review reservation requests that are waiting for custodian approval.</p>
    </div>
</div>

@if (TempData["ReservationError"] is string errorMessage)
{
    <div class="category-notice category-notice-error" role="alert">@errorMessage</div>
}

@if (loadError != null)
{
    <div class="category-notice category-notice-error" role="alert">@loadError</div>
}
else
{
    <section class="stats-grid" aria-label="Pending request overview">
        <div class="stat-card">
            <span class="stat-icon stat-icon-purple"><svg class="icon"><use href="#i-calendar" /></svg></span>
            <span class="stat-copy">
                <span>Pending requests</span>
                <strong>@Model.Count</strong>
                <small>Awaiting review</small>
            </span>
        </div>
    </section>

    <section class="content-card category-list" aria-labelledby="pendingListHeading">
        <div class="card-heading">
            <div>
                <h2 id="pendingListHeading">Approval queue</h2>
                <p>Oldest requests appear first so they can be reviewed in the order they were submitted.</p>
            </div>
            <span class="count-pill">@Model.Count @(Model.Count == 1 ? "request" : "requests")</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-categories">
                <span class="empty-icon"><svg class="icon"><use href="#i-calendar" /></svg></span>
                <h3>No pending requests</h3>
                <p>New reservation requests will appear here when borrowers submit them.</p>
            </div>
        }
        else
        {
            <div class="list-toolbar">
                <label class="search-field">
                    <svg class="icon"><use href="#i-search" /></svg>
                    <span class="sr-only">Search pending requests</span>
                    <input id="pendingSearch" type="search" placeholder="Search request, borrower, or equipment…" autocomplete="off" />
                </label>
            </div>
            <div class="table-scroll">
                <table class="category-table">
                    <thead>
                        <tr>
                            <th scope="col">REQUEST</th>
                            <th scope="col">BORROWER</th>
                            <th scope="col">EQUIPMENT</th>
                            <th scope="col">SCHEDULE</th>
                            <th scope="col">REQUESTED</th>
                            <th scope="col">STATUS</th>
                            <th scope="col" class="actions-column">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="pendingRows">
                        @foreach (var request in Model)
                        {
                            var search = $"{request.ReservationNumber} {request.BorrowerName} {request.BorrowerUserCode} {request.DepartmentName} {request.Purpose} {request.EquipmentSummary}".ToLowerInvariant();
                            <tr data-search="@search">
                                <td>
                                    <div class="category-name-cell">
                                        <span class="category-tile"><svg class="icon"><use href="#i-calendar" /></svg></span>
                                        <span>
                                            <strong>@request.ReservationNumber</strong>
                                            <small>@request.Purpose</small>
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <strong>@request.BorrowerName</strong>
                                    <div class="pending-muted">@request.BorrowerUserCode@(string.IsNullOrWhiteSpace(request.DepartmentName) ? "" : " · " + request.DepartmentName)</div>
                                </td>
                                <td>
                                    @request.EquipmentSummary
                                    <div class="pending-muted">@request.ItemCount @(request.ItemCount == 1 ? "item" : "items")</div>
                                </td>
                                <td>
                                    @request.StartDateTime.ToString("MMM d, yyyy h:mm tt")
                                    <div class="pending-muted">to @request.ExpectedReturnDateTime.ToString("MMM d, yyyy h:mm tt")</div>
                                </td>
                                <td>@request.RequestedAt.ToString("MMM d, yyyy h:mm tt")</td>
                                <td>
                                    <span class="status-badge status-pending"><span></span>@request.Status</span>
                                </td>
                                <td class="actions-column">
                                    <div class="row-actions">
                                        <a class="icon-button"
                                           asp-controller="Reservation"
                                           asp-action="Details"
                                           asp-route-id="@request.ReservationId"
                                           aria-label="View @request.ReservationNumber"
                                           title="View request">
                                            <svg class="icon"><use href="#i-eye" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="empty-results" id="emptyResults" hidden>
                <span class="empty-icon"><svg class="icon"><use href="#i-search" /></svg></span>
                <h3>No matching requests</h3>
                <p>Try a different reservation number, borrower name, or equipment name.</p>
                <button type="button" class="text-button" id="clearPendingSearch">Clear search</button>
            </div>
            <div class="table-footer"><span id="resultCount">Showing @Model.Count of @Model.Count requests</span></div>
        }
    </section>
}

@section Scripts {
    @if (Model.Count > 0 && loadError == null)
    {
        <script src="~/js/pending-requests.js" asp-append-version="true"></script>
    }
}
