@using System.Globalization
@using System.Linq
@using ASI.Basecode.Services.ServiceModels
@using ASI.Basecode.Services.ServiceModels.Reservation
@model ReservationFormModel
@{
    var editModel = Model as ReservationEditFormModel;
    var isEdit = editModel != null;
    var reservationId = isEdit ? (int?)ViewData["ReservationId"] : null;
    var formController = "Reservation";
    var changeEquipmentUrl = Url.Action("ChangeEquipment", "Reservation", new { id = reservationId });
    var selectionError = ViewData["SelectionError"] as string;
}

<div class="reservation-create" data-reservation-create>
    <button class="back-link reservation-link-button rc-back" type="submit" form="reservationForm" formaction="@changeEquipmentUrl" formnovalidate>
        <svg class="icon" aria-hidden="true">
            <use href="#i-chevron" />
        </svg>Back to equipment
    </button>
    <div class="page-heading">
        <div>
            <h1>@(isEdit ? "Edit reservation" : "Reserve equipment")</h1>
            <p>Choose a schedule that works for all your selected equipment.</p>
        </div>
    </div>
    <ol class="rc-steps" aria-label="Reservation steps">
        <li>Select equipment</li>
        <li aria-current="step">Reservation details</li>
    </ol>

    @if (selectionError != null)
    {
        <p class="category-notice category-notice-error" role="alert">@selectionError</p>
    }

    <form id="reservationForm"
          asp-controller="@formController"
          asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@reservationId" method="post">

        @if (isEdit)
        {
            <input type="hidden" name="returnUrl" value="@ViewData["ReservationReturnUrl"]" />
            <input type="hidden" name="RowVersion" value="@editModel.RowVersion" />
        }

        @foreach (var id in Model.EquipmentIds)
        {
            <input type="hidden" name="EquipmentIds" value="@id" />
        }

        <div class="rc-layout">
            <aside class="rc-summary" aria-labelledby="createEquipmentHeading">
                <section class="content-card rc-summary-card">
                    <div class="rc-summary-heading">
                        <h2 id="createEquipmentHeading">Selected equipment</h2>
                        <span>@Model.Equipment.Count @(Model.Equipment.Count == 1 ? "item" : "items")</span>
                    </div>

                    @if (Model.Equipment.Count == 0)
                    {
                        <p class="rc-hint">Select at least one item to reserve.</p>
                    }

                    <ul class="rc-selected-items">

                        @foreach (var item in Model.Equipment)
                        {
                            <li>
                                <strong>@item.EquipmentName</strong>
                                <small>@item.EquipmentCode</small>
                            </li>
                        }

                    </ul>
                    <button class="reservation-change-link reservation-link-button" type="submit" formaction="@changeEquipmentUrl" formnovalidate>
                        Change equipment
                        <svg class="icon" aria-hidden="true">
                            <use href="#i-arrow" />
                        </svg>
                    </button>
                    <p class="rc-summary-note">All items share the same schedule. Requests require approval before pickup.</p>
                </section>
            </aside>

            <section class="content-card rc-form" aria-label="Reservation details">
                <p class="rc-identity">
                    Reserving as
                    <strong>@User.Identity?.Name</strong>
                </p>

                <div asp-validation-summary="All" class="reservation-errors" role="alert"></div>
                <div class="rc-dates">
                    <div class="form-group">
                        <label asp-for="Pickup">
                            Pickup date and time
                            <span class="required" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="Pickup" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required aria-describedby="scheduleHint" />
                        <span asp-validation-for="Pickup" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ExpectedReturn">
                            Expected return date and time
                            <span class="required" aria-hidden="true">*</span>
                        </label>
                        <input asp-for="ExpectedReturn" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required aria-describedby="scheduleHint returnFeedback" />
                        <span asp-validation-for="ExpectedReturn" class="field-validation-error"></span>
                    </div>
                </div>
                <p id="scheduleHint" class="rc-hint">Philippine time (UTC+8). Return must be after pickup.</p>
                <p id="returnFeedback" class="rc-feedback" role="status" data-duration></p>

                <div class="rc-preview-actions">
                    <p class="rc-hint">
                        Choose your dates, then check availability.
                        Check again after changing your schedule.
                    </p>

                    <button class="button button-secondary"
                            type="submit"
                            formaction="@Url.Action("CheckAvailability", "Reservation", new { id = reservationId })"
                            formnovalidate>
                        Check availability
                    </button>
                </div>

                <section class="rc-availability"
                         aria-labelledby="createAvailabilityHeading">
                    <h2 id="createAvailabilityHeading">
                        Selected equipment availability
                    </h2>

                    <div class="rc-preview-actions">
                        <div class="form-group">
                            <label asp-for="PreviewDay">Day to preview</label>

                            <input asp-for="PreviewDay"
                                   type="date"
                                   asp-format="{0:yyyy-MM-dd}" />

                            <span asp-validation-for="PreviewDay"
                                  class="field-validation-error"></span>
                        </div>

                        <button class="button button-secondary"
                                type="submit"
                                name="previewAction"
                                value="day"
                                formaction="@Url.Action("CheckAvailability", "Reservation",
                                                new { id = reservationId })"
                                formnovalidate>
                            View day
                        </button>

                        <button class="button button-secondary"
                                type="submit"
                                name="previewAction"
                                value="full"
                                formaction="@Url.Action("CheckAvailability", "Reservation",
                                                new { id = reservationId })"
                                formnovalidate>
                            Full period
                        </button>
                    </div>

                    @if (Model.AvailabilityPreview == null)
                    {
                        <p class="rc-hint">
                            Choose your dates and click Check availability
                            to view existing bookings.
                        </p>
                    }
                    else
                    {
                        var preview = Model.AvailabilityPreview;
                        var rangeStart = preview.RangeStart;
                        var rangeEnd = preview.RangeEnd;
                        var totalMinutes = (rangeEnd - rangeStart).TotalMinutes;

                        string Position(DateTime value) => ((value - rangeStart).TotalMinutes / totalMinutes * 100).ToString("0.###", CultureInfo.InvariantCulture);

                        string Width(DateTime start, DateTime end) => ((end - start).TotalMinutes / totalMinutes * 100).ToString("0.###", CultureInfo.InvariantCulture);

                        <p class="rc-hint">
                            @(preview.IsDayView ? "Day detail" : "Schedule overview"):
                            @rangeStart.ToString("MMM d, yyyy h:mm tt")
                            to
                            @rangeEnd.ToString("MMM d, yyyy h:mm tt")
                        </p>

                        <p class="rc-hint">
                            Last checked schedule:
                            @preview.Pickup.ToString("MMM d, yyyy h:mm tt")
                            to
                            @preview.ExpectedReturn.ToString("MMM d, yyyy h:mm tt")
                            (Philippine time).
                            Check again after changing dates.
                        </p>

                        <div class="rc-legend">
                            <span>
                                <i class="rc-key-booking" aria-hidden="true"></i>
                                Existing booking / maintenance
                            </span>
                            <span>
                                <i class="rc-key-selection" aria-hidden="true"></i>
                                Your selected time
                            </span>
                            <span>
                                <i class="rc-key-conflict" aria-hidden="true"></i>
                                Overlapping period
                            </span>
                        </div>

                        @foreach (var item in preview.Items)
                        {
                            var equipment = Model.Equipment.FirstOrDefault(
                            equipment => equipment.EquipmentId == item.EquipmentId);

                            <div class="rc-equipment-row">
                                <div class="rc-row-title">
                                    <strong>
                                        @(equipment?.EquipmentName ?? "Unavailable equipment")
                                    </strong>
                                    <small>@equipment?.EquipmentCode</small>
                                </div>

                                <div class="rc-row-schedule">
                                    <div class="rc-axis">
                                        <span>@rangeStart.ToString("MMM d, h:mm tt")</span>
                                        <span>@rangeEnd.ToString("MMM d, h:mm tt")</span>
                                    </div>

                                    <div class="rc-track" aria-hidden="true">
                                        @{
                                            var selectionStart = preview.Pickup < rangeStart
                                            ? rangeStart
                                            : preview.Pickup;

                                            var selectionEnd = preview.ExpectedReturn > rangeEnd
                                            ? rangeEnd
                                            : preview.ExpectedReturn;
                                        }

                                        @if (selectionEnd > selectionStart)
                                        {
                                            <div class="rc-selection"
                                                 style="left: @(Position(selectionStart))%; width: @(Width(selectionStart, selectionEnd))%;">
                                            </div>
                                        }

                                        @foreach (var period in item.Periods)
                                        {
                                            var start = period.Start < rangeStart
                                            ? rangeStart : period.Start;
                                            var end = period.End > rangeEnd
                                            ? rangeEnd : period.End;

                                            var overlaps =
                                            period.Start < preview.ExpectedReturn &&
                                            period.End > preview.Pickup;

                                            if (end > start)
                                            {
                                                <div class="rc-period @(overlaps ? "is-overlap" : "")"
                                                     style="left: @(Position(start))%; width: @(Width(start, end))%;">
                                                </div>
                                            }
                                        }
                                    </div>

                                    <p class="rc-row-state @(!item.IsAvailable ? "is-error" : "")">
                                        @(item.IsAvailable ? "Available for the checked schedule." : item.Reason)
                                    </p>

                                    <ul class="rc-booking-list">
                                        @foreach (var period in item.Periods)
                                        {
                                            var overlaps =
                                            period.Start < preview.ExpectedReturn &&
                                            period.End > preview.Pickup;

                                            <li class="@(overlaps ? "is-overlap" : "")">
                                                @period.Type:
                                                @period.Start.ToString("MMM d, yyyy h:mm tt")
                                                to
                                                @period.End.ToString("MMM d, yyyy h:mm tt")
                                                @(overlaps ? " - Overlaps your schedule" : "")
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        }

                        <p class="rc-preview-status">
                            This preview does not reserve equipment.
                            Availability is checked again when you submit.
                        </p>
                    }
                </section>
                <div class="form-group rc-purpose">
                    <label asp-for="Purpose">
                        Purpose of borrowing
                        <span class="required" aria-hidden="true">*</span>
                    </label>
                    <textarea asp-for="Purpose" rows="3" maxlength="500" required placeholder="For example, a class presentation or laboratory activity."></textarea>
                    <span asp-validation-for="Purpose" class="field-validation-error"></span>
                </div>
                <div class="rc-submit-area">
                    <p class="rc-hint">Availability is checked again when you submit.</p>
                    @if (isEdit)
                    {
                        <button class="button button-secondary" type="submit"
                                formaction="@Url.Action("DiscardEdit", "Reservation", new { id = reservationId })"
                                formnovalidate>
                            Discard changes
                        </button>
                    }
                    <button class="button button-primary" type="submit" data-submit-request>@(isEdit ? "Save changes" : "Submit request")</button>
                </div>
            </section>

        </div>
    </form>
</div>
