                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col">Starts</th>
                            <th scope="col">Ends</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.EquipmentSchedule)
                        {
                            <tr>
                                <td>
                                    <div class="category-name-cell">
                                        <span class="category-tile"><svg class="icon"><use href="#i-calendar" /></svg></span>
                                        <span><strong>@entry.EquipmentName</strong><small>@entry.EquipmentCode</small></span>
                                    </div>
                                </td>
                                <td><span class="role-pill">@entry.Type</span></td>
                                <td><span class="status-badge status-@entry.Status.ToLowerInvariant()"><span></span>@entry.Status</span></td>
                                <td>@entry.Start.ToString("MMM d, yyyy h:mm tt")</td>
