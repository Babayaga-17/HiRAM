@using ASI.Basecode.Resources.Constants
@using ASI.Basecode.Services.ServiceModels
@using ASI.Basecode.Services.ServiceModels.UserAccount
@model UserAccountFormViewModel
@{
    var roles = RoleNames.All;
    var departments = ViewData["Departments"] as List<ASI.Basecode.Data.Models.Department>
        ?? new List<ASI.Basecode.Data.Models.Department>();
    var isSelf = ViewData["IsSelf"] as bool? == true;
    var showBorrower = Model.RoleName == RoleNames.Borrower;
}
<form class="category-form" id="userAccountForm" asp-controller="UserAccount" asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post" novalidate data-academic-fields>
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="UserId" type="hidden" />
    <input asp-for="Version" type="hidden" />

    <div class="form-card-header">
        <span class="form-section-icon"><svg class="icon"><use href="#i-user" /></svg></span>
        <div><h2>Personal information</h2><p>Details used to identify this user.</p></div>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label for="UserCode">User ID <span class="required">*</span></label>
            <input asp-for="UserCode" type="text" maxlength="30" placeholder="e.g. 2026-10482" required />
            <span asp-validation-for="UserCode"></span>
            <small>Student, faculty, or staff ID. Must be unique.</small>
        </div>
        <div class="form-group">
            <label for="ContactNumber">Contact number</label>
            <input asp-for="ContactNumber" type="text" maxlength="30" placeholder="e.g. 0917 123 4567" />
            <span asp-validation-for="ContactNumber"></span>
        </div>
        <div class="form-group">
            <label for="FirstName">First name <span class="required">*</span></label>
            <input asp-for="FirstName" type="text" maxlength="100" required />
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="form-group">
            <label for="MiddleName">Middle name</label>
            <input asp-for="MiddleName" type="text" maxlength="100" />
            <span asp-validation-for="MiddleName"></span>
        </div>
        <div class="form-group">
            <label for="LastName">Last name <span class="required">*</span></label>
            <input asp-for="LastName" type="text" maxlength="100" required />
            <span asp-validation-for="LastName"></span>
        </div>
        <div class="form-group">
            <label for="Suffix">Suffix</label>
            <input asp-for="Suffix" type="text" maxlength="20" placeholder="e.g. Jr." />
            <span asp-validation-for="Suffix"></span>
        </div>
    </div>

    <div class="form-divider"></div>

    <div class="form-card-header">
        <span class="form-section-icon"><svg class="icon"><use href="#i-shield" /></svg></span>
        <div><h2>Account and role</h2><p>Sign-in email, role, and account status.</p></div>
    </div>

    <div class="form-grid">
        <div class="form-group form-group-wide">
            <label for="Email">Email <span class="required">*</span></label>
            <input asp-for="Email" type="email" maxlength="255" placeholder="name@school.edu" required />
            <span asp-validation-for="Email"></span>
            <small>Used to sign in. Must be unique.</small>
        </div>
        <div class="form-group">
            <label asp-for="RoleName">
                Role <span class="required">*</span>
            </label>

            @if (isSelf || Model.AccountStatus == AccountStatuses.PendingApproval)
            {
                <input asp-for="RoleName" type="hidden" />
                <select disabled aria-label="Role">
                    <option>@Model.RoleName</option>
                </select>
                <small>
                    @(Model.AccountStatus == AccountStatuses.PendingApproval
                                    ? "The Borrower role is retained during registration review."
                                    : "You cannot change your own role.")
                </small>
            }
            else
            {
                <select asp-for="RoleName" required>
                    <option value="">Select a role</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <small>Controls which menus and functions the user can open.</small>
            }

            <span asp-validation-for="RoleName"></span>
        </div>
        <div class="form-group">
            <label for="AccountStatus">Status <span class="required">*</span></label>
            @if (isSelf || Model.AccountStatus == AccountStatuses.PendingApproval)
            {
                <input asp-for="AccountStatus" type="hidden" />
                <select id="AccountStatus" disabled><option>@Model.AccountStatus</option></select>
                <small>@(Model.AccountStatus == AccountStatuses.PendingApproval ? "Use registration approval to grant access." : "You cannot deactivate your own account.")</small>
            }
            else
            {
                <select asp-for="AccountStatus">
                    @foreach (var status in AccountStatuses.All)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
                <small>Only Active accounts can sign in.</small>
            }
            <span asp-validation-for="AccountStatus"></span>
        </div>

        @if (!Model.IsEdit)
        {
            <div class="form-group">
                <label for="Password">
                    Password <span class="required">*</span>
                </label>
                <input asp-for="Password"
                       type="password"
                       maxlength="64"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="form-group">
                <label for="ConfirmPassword">
                    Confirm password <span class="required">*</span>
                </label>
                <input asp-for="ConfirmPassword"
                       type="password"
                       maxlength="64"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        }
    </div>

    <div id="borrowerDetails" class="borrower-details">
        <div class="form-divider"></div>

        <div class="form-card-header">
            <span class="form-section-icon"><svg class="icon"><use href="#i-user" /></svg></span>
            <div><h2>Borrower details</h2><p>Required when the role is Borrower.</p></div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label for="DepartmentId">Department <span class="required">*</span></label>
                <select asp-for="DepartmentId" data-academic-department>
                    <option value="">Select a department</option>
                    @foreach (var department in departments)
                    {
                        <option value="@department.DepartmentId">@department.DepartmentName</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId"></span>
            </div>

            <div class="form-group">
                <label for="Program">Program <span class="required">*</span></label>
                <select asp-for="Program" data-academic-program>
                    <partial name="_AcademicProgramOptions" model="@((departments.AsEnumerable(), Model.Program))" />
                </select>
                <span asp-validation-for="Program"></span>
            </div>

            <div class="form-group">
                <label for="YearLevel">Year level <span class="required">*</span></label>
                <select asp-for="YearLevel">
                    <option value="">Select a year level</option>
                    @for (var level = 1; level <= 5; level++)
                    {
                        <option value="@level">Year @level</option>
                    }
                </select>
                <span asp-validation-for="YearLevel"></span>
            </div>

            <div class="form-group">
                <label for="EligibilityStatus">Eligibility <span class="required">*</span></label>
                @if (Model.EligibilityLocked)
                {
                    <select asp-for="EligibilityStatus" disabled>
                        <option value="@Model.EligibilityStatus">@Model.EligibilityStatus</option>
                    </select>
                    <small>Eligibility is managed by registration review or suspension.</small>
                }
                else
                {
                    <select asp-for="EligibilityStatus">
                        @foreach (var status in UserAccountFormViewModel.EligibilityOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                }
                <span asp-validation-for="EligibilityStatus"></span>
            </div>

            <div class="form-group">
                <label for="BorrowerType">Borrower type <span class="required">*</span></label>
                <select asp-for="BorrowerType">
                    <option value="">Select a type</option>
                    @foreach (var type in UserAccountFormViewModel.BorrowerTypeOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                <span asp-validation-for="BorrowerType"></span>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a class="button button-secondary" asp-controller="UserAccount" asp-action="@(Model.IsEdit ? "Details" : "Index")" asp-route-id="@(Model.IsEdit? Model.UserId.ToString() : null)">Cancel</a>
        <button class="button button-primary" type="submit" id="userAccountSubmit">
            <svg class="icon"><use href="#i-check" /></svg>@(Model.IsEdit ? "Save changes" : "Create user")
        </button>
    </div>
</form>
<script src="~/js/academic-options.js" asp-append-version="true"></script>
