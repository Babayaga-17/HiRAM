@model string
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reservation Submitted";
    ViewData["TopbarPage"] = "Equipment reservation";
}
@section Styles {
    <link rel="stylesheet" href="~/css/equipment-reservation.css" asp-append-version="true" />
}
<section class="content-card reservation-empty" role="status">
    <span class="form-section-icon"><svg class="icon" aria-hidden="true"><use href="#i-check" /></svg></span>
    <h1>Reservation submitted</h1>
    <p>Your request is pending approval. Wait for approval before collecting the equipment.</p>
    <p>Reservation number: <strong>@Model</strong></p>
    <a class="button button-primary"
       asp-controller="EquipmentReservation"
       asp-action="Index">
        My Reservations
    </a>
</section>
