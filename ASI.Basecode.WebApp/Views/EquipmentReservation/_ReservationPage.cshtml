@using ASI.Basecode.Services.ServiceModels
@using ASI.Basecode.Services.ServiceModels.Reservation
@model ReservationFormModel

@{
    var editModel = Model as ReservationEditFormModel;
    var isEdit = editModel != null;

    var reservationId = isEdit
        ? (int?)ViewData["ReservationId"]
        : null;

    var selectionError = ViewData["SelectionError"] as string;

    var changeEquipmentUrl = Url.Action(
        "ChangeEquipment",
        "EquipmentReservation",
        new { id = reservationId });
}

<div class="page-heading form-page-heading">
    <div>
        <button class="back-link reservation-link-button"
                type="submit"
                form="reservationForm"
                formaction="@changeEquipmentUrl"
                formnovalidate>
            <svg class="icon" aria-hidden="true">
                <use href="#i-chevron" />
            </svg>
            Back to equipment
        </button>

        <h1>@(isEdit ? "Edit reservation" : "Reserve equipment")</h1>
        <p>Check your selected items and tell us when you need them.</p>
    </div>
</div>

<ol class="reservation-steps" aria-label="Reservation steps">
    <li><span aria-hidden="true">1</span>Select equipment</li>
    <li class="is-current" aria-current="step">
        <span aria-hidden="true">2</span>Reservation details
    </li>
</ol>

@if (selectionError != null)
{
    <p class="category-notice category-notice-error" role="alert">
        @selectionError
    </p>
}

<form id="reservationForm"
      asp-controller="EquipmentReservation"
      asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@reservationId"
      method="post">

    @if (isEdit)
    {
        <input type="hidden"
               name="RowVersion"
               value="@editModel.RowVersion" />
    }

    @foreach (var id in Model.EquipmentIds)
    {
        <input type="hidden" name="EquipmentIds" value="@id" />
    }

    <div class="reservation-layout">
        <section class="content-card form-card"
                 aria-labelledby="reservationDetailsHeading">

            <div class="form-card-header">
                <span class="form-section-icon">
                    <svg class="icon" aria-hidden="true">
                        <use href="#i-calendar" />
                    </svg>
                </span>
                <div>
                    <h2 id="reservationDetailsHeading">
                        Reservation details
                    </h2>
                    <p>
                        Choose your borrowing schedule and describe
                        how you will use the equipment.
                    </p>
                </div>
            </div>

            <div asp-validation-summary="All"
                 class="reservation-errors"
                 role="alert"></div>

            <div class="form-grid">
                <div class="form-group form-group-wide">
                    <label for="reservationBorrower">Borrower</label>
                    <input id="reservationBorrower"
                           type="text"
                           value="@User.Identity?.Name"
                           readonly />
                    <small>This reservation is for your signed-in account.</small>
                </div>

                <div class="form-group">
                    <label asp-for="Pickup">
                        Pickup date and time
                        <span class="required" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="Pickup"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           required />
                </div>

                <div class="form-group">
                    <label asp-for="ExpectedReturn">
                        Expected return date and time
                        <span class="required" aria-hidden="true">*</span>
                    </label>
                    <input asp-for="ExpectedReturn"
                           type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           required
                           aria-describedby="returnHint" />
                    <small id="returnHint">
                        Choose a time after your pickup.
                    </small>
                </div>

                <div class="form-group form-group-wide">
                    <label asp-for="Purpose">
                        Purpose of borrowing
                        <span class="required" aria-hidden="true">*</span>
                    </label>
                    <textarea asp-for="Purpose"
                              rows="5"
                              maxlength="500"
                              required></textarea>
                </div>
            </div>

            <div class="reservation-preview-note">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-info" />
                </svg>
                <p>
                    Times are in Philippine time.
                    Availability is checked when you
                    @(isEdit ? "save your changes." : "submit your request.")
                </p>
            </div>

            <div class="form-actions">
                @if (isEdit)
                {
                    <button class="button button-secondary"
                            type="submit"
                            formaction="@Url.Action("DiscardEdit", "EquipmentReservation", new { id = reservationId })"
                            formnovalidate>
                        Discard changes
                    </button>
                }
                else
                {
                    <button class="button button-secondary"
                            type="submit"
                            formaction="@changeEquipmentUrl"
                            formnovalidate>
                        Back to equipment
                    </button>
                }

                <button class="button button-primary" type="submit">
                    @(isEdit ? "Save changes" : "Submit reservation")
                </button>
            </div>
        </section>

        <aside class="reservation-summary"
               aria-labelledby="selectedEquipmentHeading">
            <section class="content-card reservation-summary-card">
                <div class="reservation-summary-heading">
                    <h2 id="selectedEquipmentHeading">
                        Selected equipment
                    </h2>
                    <span class="reservation-item-count">
                        @Model.Equipment.Count
                        @(Model.Equipment.Count == 1 ? "item" : "items")
                    </span>
                </div>

                @if (Model.Equipment.Count == 0)
                {
                    <p>Select at least one item to reserve.</p>
                }

                <ul class="reservation-items">
                    @foreach (var item in Model.Equipment)
                    {
                        <li>
                            <span class="form-section-icon">
                                <svg class="icon" aria-hidden="true">
                                    <use href="#i-box" />
                                </svg>
                            </span>
                            <div>
                                <strong>@item.EquipmentName</strong>
                                <small>@item.EquipmentCode</small>
                            </div>
                        </li>
                    }
                </ul>

                <button class="reservation-change-link reservation-link-button"
                        type="submit"
                        formaction="@changeEquipmentUrl"
                        formnovalidate>
                    Change selected equipment
                </button>
            </section>

            <section class="reservation-reminder">
                <h2>Before you reserve</h2>
                <p>
                    The same pickup and return schedule applies
                    to all selected items.
                </p>
                <p>
                    A reservation request will need approval
                    before you can collect the equipment.
                </p>
            </section>
        </aside>
    </div>
</form>