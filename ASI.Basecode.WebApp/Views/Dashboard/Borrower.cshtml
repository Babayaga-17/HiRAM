@using System.Linq
@using ASI.Basecode.Resources.Constants
@using ASI.Basecode.Services.ServiceModels
@model BorrowerDashboardViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Borrower dashboard";
    ViewData["TopbarPage"] = "Dashboard";
    var overview = Model ?? new BorrowerDashboardViewModel();
    string Number(int? count) => count?.ToString("N0") ?? "—";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role-dashboard.css" asp-append-version="true" />
}

<div class="role-dashboard borrower-dashboard">
    <header class="rd-heading">
        <div>
            <h1>Borrower dashboard</h1>
            <p>Keep track of your reservations and equipment returns.</p>
        </div>

        <a class="button button-primary" asp-controller="BrowseEquipment" asp-action="Index">
            Browse equipment
            <svg class="icon" aria-hidden="true">
                <use href="#i-arrow" />
            </svg>
        </a>
    </header>

    <section class="stats-grid rd-summary" aria-label="Your borrowing overview">
        <div class="stat-card">
            <span class="stat-copy">
                <span>Pending requests</span>
                <strong>@Number(overview.Count(ReservationStatuses.Pending))</strong>
                <small>Awaiting staff review</small>
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-copy">
                <span>Active borrowings</span>
                <strong>@Number(overview.OutstandingCount)</strong>
                <small>Reservations with equipment still out</small>
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-copy">
                <span>Overdue returns</span>
                <strong>@Number(overview.OverdueCount)</strong>
                <small>Outstanding past the return deadline</small>
            </span>
        </div>
    </section>

    <section class="rd-panel" aria-labelledby="borrowerRecentHeading">
        <header class="rd-panel-heading">
            <div>
                <h2 id="borrowerRecentHeading">Recent reservations</h2>
                <p>Your latest requests, across all statuses</p>
            </div>

            <a class="rd-link" asp-controller="Reservation" asp-action="MyReservation">
                Manage pending requests
                <svg class="icon" aria-hidden="true">
                    <use href="#i-arrow" />
                </svg>
            </a>
        </header>

        @if (overview.Reservations == null)
        {
            <p class="rd-state" role="status">Your reservation history is unavailable.</p>
        }
        else if (!overview.Recent.Any())
        {
            <p class="rd-state">No reservations yet. Browse equipment to make your first request.</p>
        }
        else
        {
            <partial name="_BorrowerReservations" model="overview.Recent" />
        }
    </section>
</div>
