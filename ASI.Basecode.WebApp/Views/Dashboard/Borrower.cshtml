@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Borrower dashboard";
    ViewData["TopbarPage"] = "Dashboard";
}

<header class="page-heading">
    <div>
        <h1>Borrowing dashboard</h1>
        <p>Welcome, @User.Identity?.Name. Find equipment and manage your reservations here.</p>
    </div>
    <a class="button button-primary heading-action" asp-controller="BrowseEquipment" asp-action="Index">
        Browse equipment <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
    </a>
</header>

<div class="dashboard-layout">
    <section class="dashboard-feature" aria-labelledby="requestsHeading">
        <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
        <h2 id="requestsHeading">Plan your next loan</h2>
        <p>Use the availability calendar to check bookings for the equipment you need.</p>
        <a class="button button-secondary" asp-controller="AvailabilityCalendar" asp-action="Index">View availability</a>
    </section>

    <section class="dashboard-links" aria-labelledby="loansHeading">
        <h2 id="loansHeading">Your requests and loans</h2>
        <a class="dashboard-link" asp-controller="EquipmentReservation" asp-action="Index">
            <span><strong>My reservations</strong><small>Check request status, return dates, and previous reservations.</small></span>
            <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
    </section>
</div>
