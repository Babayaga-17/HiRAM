@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Admin dashboard";
    ViewData["TopbarPage"] = "Dashboard";

    var pendingCount = ViewBag.PendingCount as int?;
    var canManageUsers = ASI.Basecode.WebApp.Authorization.MenuAccess.CanAccess(User, "UserAccount");
}

<header class="page-heading">
    <div>
        <h1>Administration dashboard</h1>
        <p>Oversee equipment, requests, and borrower access.</p>
    </div>
    <a class="button button-primary heading-action" asp-controller="Reservation" asp-action="Pending">
        Review requests <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
    </a>
</header>

<div class="dashboard-layout">
    <section class="dashboard-feature" aria-labelledby="pendingHeading">
        <h2 id="pendingHeading">Pending requests</h2>
        <p class="dashboard-number">@(pendingCount?.ToString() ?? "—")</p>
        <p>@(pendingCount.HasValue ? "Reservations awaiting review." : "The pending request count is unavailable.")</p>
        <a class="button button-secondary" asp-controller="Reservation" asp-action="Returns">View returns</a>
    </section>

    <partial name="_InventoryLinks" />
</div>

@if (canManageUsers)
{
    <section class="dashboard-links dashboard-people" aria-labelledby="peopleHeading">
        <h2 id="peopleHeading">People and activity</h2>
        <a class="dashboard-link" asp-controller="UserAccount" asp-action="Index">
            <span><strong>User accounts</strong><small>Manage accounts and role assignments.</small></span>
            <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
        <a class="dashboard-link" asp-controller="BorrowerProfile" asp-action="Index">
            <span><strong>Borrower profiles</strong><small>Find student and faculty records.</small></span>
            <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
        <a class="dashboard-link" asp-controller="Report" asp-action="Index">
            <span><strong>Borrowing history report</strong><small>Review completed loans and late returns.</small></span>
            <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
        </a>
    </section>
}
