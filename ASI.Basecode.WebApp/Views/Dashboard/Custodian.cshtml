@using System.Linq
@using ASI.Basecode.Services.ServiceModels
@model List<PendingReservationListItem>
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Custodian Dashboard";
    ViewData["TopbarPage"] = "Dashboard";
    var pending = Model ?? new List<PendingReservationListItem>();
}

<header class="page-heading">
    <div>
        <h1>Equipment desk dashboard</h1>
        <p>Review borrowing requests and track equipment due back.</p>
    </div>
    <a class="button button-primary heading-action" asp-controller="Reservation" asp-action="Pending">
        Review requests <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
    </a>
</header>

<section class="dashboard-queue" aria-labelledby="approvalsHeading">
    <div class="dashboard-queue-heading">
        <div>
            <h2 id="approvalsHeading">Pending approval queue</h2>
            <p>@pending.Count @(pending.Count == 1 ? "request" : "requests") awaiting review.</p>
        </div>
        <a class="button button-secondary" asp-controller="Reservation" asp-action="Returns">View returns</a>
    </div>
    @if (pending.Count == 0)
    {
        <p class="dashboard-empty">There are no pending requests right now.</p>
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Pending approval queue" tabindex="0">
            <table class="category-table">
                <thead>
                    <tr>
                        <th scope="col">Request</th>
                        <th scope="col">Borrower</th>
                        <th scope="col">Equipment</th>
                        <th scope="col">Schedule</th>
                        <th scope="col" class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in pending.Take(5))
                    {
                        <tr>
                            <td>
                                <strong>@request.ReservationNumber</strong>
                                <div class="pending-muted">@request.Purpose</div>
                            </td>
                            <td>@request.BorrowerName</td>
                            <td>@request.EquipmentSummary</td>
                            <td>@request.StartDateTime.ToString("MMM d, yyyy h:mm tt")</td>
                            <td class="actions-column">
                                <a class="icon-button"
                                   asp-controller="Reservation"
                                   asp-action="Details"
                                   asp-route-id="@request.ReservationId"
                                   aria-label="View @request.ReservationNumber"
                                   title="View request">
                                    <svg class="icon"><use href="#i-eye" /></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<partial name="_InventoryLinks" />
