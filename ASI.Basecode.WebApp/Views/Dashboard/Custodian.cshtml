@using System.Linq
@using ASI.Basecode.Resources.Constants
@using ASI.Basecode.Services.ServiceModels.Dashboard
@model CustodianDashboardViewModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Custodian dashboard";
    ViewData["TopbarPage"] = "Dashboard";
    var overview = Model ?? new CustodianDashboardViewModel();
    string Number(int? count) => count?.ToString("N0") ?? "—";
}
@section Styles {
    <link rel="stylesheet" href="~/css/role-dashboard.css" asp-append-version="true" />
}
<div class="role-dashboard custodian-dashboard">
    <header class="rd-heading">
        <div>
            <h1>Custodian dashboard</h1>
            <p>Review requests and coordinate equipment borrowing.</p>
        </div>
    </header>
    <section class="stats-grid rd-summary" aria-label="Equipment desk overview">
        <div class="stat-card">
            <span class="stat-copy">
                <span>Pending review</span>
                <strong>@Number(overview.Count(ReservationStatuses.Pending))</strong>
                <small>Reservation requests</small>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-copy">
                <span>Awaiting release</span>
                <strong>@Number(overview.Count(ReservationStatuses.Approved))</strong>
                <small>Approved; equipment not yet released</small>
            </span>
        </div>
        <div class="stat-card">
            <span class="stat-copy">
                <span>Outstanding loans</span>
                <strong>@Number(overview.OutstandingCount)</strong>
                <small>Reservations with equipment still out</small>
            </span>
        </div>
    </section>
    <section class="rd-panel" aria-labelledby="custodianReviewHeading">
        <header class="rd-panel-heading">
            <div>
                <h2 id="custodianReviewHeading">Requests to review</h2>
                <p>Oldest submitted first · Up to four requests</p>
            </div>
            <a class="rd-link" asp-controller="Reservation" asp-action="Pending">
                View all
                <svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg>
            </a>
        </header>
        @if (overview.Pending == null)
        {
            <p class="rd-state" role="status">The review queue could not be loaded. Refresh to try again.</p>
        }
        else if (overview.Pending.Items.Count == 0)
        {
            <p class="rd-state">No reservation requests are awaiting review.</p>
        }
        else
        {
            <ul class="rd-staff-list">
                @foreach (var request in overview.Pending.Items.Take(4))
                {
                    <li>
                        <div class="rd-record-title">
                            <strong>@request.ReservationNumber</strong>
                            <span class="rd-status status-pending">Pending</span>
                        </div>
                        <p>@request.BorrowerName · @request.EquipmentSummary</p>
                        <div class="rd-record-bottom">
                            <span>Pickup @request.StartDateTime.ToString("MMM d, yyyy · h:mm tt")</span>
                            <a class="rd-row-action" 
                                asp-controller="Reservation" 
                                asp-action="Review" 
                                asp-route-id="@request.ReservationId" aria-label="Review request @request.ReservationNumber">
                                Review
                                <svg class="icon" aria-hidden="true">
                                    <use href="#i-arrow" />
                                </svg>
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>
